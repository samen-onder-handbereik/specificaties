{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samen-onder-handbereik.github.io/specificaties/jsonschema/prov-jsonld.schema.json",
  "title": "Samen Onder Handbereik PROV-JSON-LD payload",
  "description": "Structureel JSON Schema voor een PROV-JSON-LD payload binnen Samen Onder Handbereik. Het schema valideert de JSON-structuur en enkele profielafspraken, maar niet de volledige semantische geldigheid van de PROV-graaf.",
  "type": "object",
  "required": [
    "@context",
    "@graph"
  ],
  "properties": {
    "@context": {
      "type": "object",
      "required": [
        "prov",
        "soh"
      ],
      "properties": {
        "prov": {
          "const": "http://www.w3.org/ns/prov#"
        },
        "soh": {
          "const": "https://samen-onder-handbereik.github.io/specificaties/schema/"
        }
      },
      "additionalProperties": true
    },
    "@graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/graphElement"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "@type"
            ],
            "properties": {
              "@type": {
                "$ref": "#/$defs/typeContainingProvEntity"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "@type"
            ],
            "properties": {
              "@type": {
                "$ref": "#/$defs/typeContainingProvActivity"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "@type"
            ],
            "properties": {
              "@type": {
                "$ref": "#/$defs/typeContainingProvAgent"
              }
            }
          },
          "minContains": 1
        }
      ]
    }
  },
  "$defs": {
    "graphElement": {
      "type": "object",
      "required": [
        "@id",
        "@type"
      ],
      "properties": {
        "@id": {
          "type": "string",
          "minLength": 1
        },
        "@type": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "typeContainingProvEntity": {
      "oneOf": [
        {
          "const": "prov:Entity"
        },
        {
          "type": "array",
          "contains": {
            "const": "prov:Entity"
          },
          "minContains": 1
        }
      ]
    },
    "typeContainingProvActivity": {
      "oneOf": [
        {
          "const": "prov:Activity"
        },
        {
          "type": "array",
          "contains": {
            "const": "prov:Activity"
          },
          "minContains": 1
        }
      ]
    },
    "typeContainingProvAgent": {
      "oneOf": [
        {
          "const": "prov:Agent"
        },
        {
          "type": "array",
          "contains": {
            "const": "prov:Agent"
          },
          "minContains": 1
        }
      ]
    }
  }
}
